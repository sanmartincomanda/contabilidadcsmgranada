rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /whatsapp/originales/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /whatsapp/{category}/{allPaths=**} {
      allow read, write: if request.auth != null && category != 'originales';
    }

    match /{topLevel}/{allPaths=**} {
      allow read, write: if request.auth != null && topLevel != 'whatsapp';
    }
  }
}
