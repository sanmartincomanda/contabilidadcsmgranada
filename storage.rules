rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /whatsapp/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && topLevel != 'whatsapp';
    }
  }
}
